{{define "title"}}Create a new recipe{{end}}

{{define "main"}}
    <form action='/recipe/create' method='POST'>
        <div>
            <label>Name:</label>
            <input type='text' name='name'>
        </div>
        <div>
            <label>Notes</label>
            <textarea name='notes'></textarea>
        </div>
        <div>
            <label>Serves</label>
            <input type="number" name="serves" id="serves">
        </div>
        <div>
            <label>Meal prepabled?</label>
            <input type='checkbox' name='can_meal_prep' value='false'>
        </div>
        <div>
            <input type='submit' value='Create recipe'>
        </div>
    </form>
{{end}}
